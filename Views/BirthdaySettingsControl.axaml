<controls:ComponentBase x:TypeArguments="componentSettings:BirthdaySettings"
                        x:Class="ClassIsland.AZSMYPlugin.Views.BirthdaySettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.AZSMYPlugin.Views"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:componentSettings="clr-namespace:ClassIsland.AZSMYPlugin.Models.ComponentSettings"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:BirthdaySettingsControl}}">

            <!-- 生日表格文件选择 -->
            <StackPanel Spacing="6">
                <TextBlock Text="生日表格文件" FontWeight="SemiBold" />
                <TextBlock Text="支持 .xlsx / .csv / .txt / .tsv。读取后可在下方查看姓名和生日。"
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding Settings.FilePath}"
                             Watermark="选择文件路径…"
                             IsReadOnly="True"
                             Width="250" />
                    <Button x:Name="BrowseButton" Content="浏览…" Click="OnBrowseClick" />
                    <Button x:Name="RefreshButton" Content="刷新" Click="OnRefreshClick" />
                </StackPanel>
                <TextBlock Text="{Binding Settings.LoadStatus}"
                           FontSize="12" Opacity="0.6" />
            </StackPanel>

            <!-- 姓名查看 -->
            <StackPanel Spacing="6">
                <TextBlock Text="姓名" FontWeight="SemiBold" />
                <ComboBox x:Name="NamesCombo"
                          ItemsSource="{Binding Settings.Names}"
                          SelectionChanged="OnNameSelectionChanged"
                          HorizontalAlignment="Left"
                          MinWidth="200" />
            </StackPanel>

            <!-- 生日查看（显示选中姓名的生日） -->
            <StackPanel Spacing="6">
                <TextBlock Text="生日" FontWeight="SemiBold" />
                <TextBlock x:Name="BirthdayTextBlock"
                           Text=""
                           FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 最多显示人数 -->
            <StackPanel Spacing="6">
                <TextBlock Text="最多显示人数" FontWeight="SemiBold" />
                <TextBlock Text="今日生日人数超过此值时，超出部分不显示。"
                           FontSize="12" Opacity="0.6" />
                <NumericUpDown Minimum="1" Maximum="100"
                               Value="{Binding Settings.MaxNamesToShow}"
                               FormatString="0"
                               Width="200"
                               HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 字体大小 -->
            <StackPanel Spacing="6">
                <TextBlock Text="字体大小" FontWeight="SemiBold" />
                <Slider Minimum="12" Maximum="40"
                        Value="{Binding Settings.FontSize}"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>

            <!-- 渐变颜色开关 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="使用彩色渐变文字" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding Settings.UseGradientColor}" />
            </StackPanel>

            <!-- 无人生日时隐藏 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="没有人过生日时隐藏" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding Settings.HideWhenNoBirthday}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
